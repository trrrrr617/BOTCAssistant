# LLM Provider: 'anthropic' or 'openai'
LLM_PROVIDER=anthropic

# Model name (use a model you have access to)
LLM_MODEL=MiniMax-M3

# API keys (leave blank to run in pure-template fallback mode)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LLM call timeout (seconds)
LLM_TIMEOUT=20

# Fallback behavior when LLM fails: 'template' or 'disabled'
LLM_FALLBACK=template

# Server bind
HOST=0.0.0.0
PORT=5000

# Default script id
DEFAULT_SCRIPT=midnight_oasis
